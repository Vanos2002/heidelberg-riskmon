<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.matejvana.riskmon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Frameworks/Python.framework/Versions/3.12/bin/python3</string>
    <string>-m</string>
    <string>riskmon</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/matejvana/security_testing</string>
  <!-- every 10 minutes -->
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/matejvana/security_testing/logs/riskmon.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/matejvana/security_testing/logs/riskmon.log</string>
</dict>
</plist>
